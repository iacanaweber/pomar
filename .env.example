# ----------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha. O `.env` NÃO vai para o git.
# ----------------------------------------------------------------------------

# --- Segurança (v2) ---
# Senha única que protege TODA a API (a carteira é um dado sensível). Sem ela, as
# rotas protegidas respondem 503. Use uma senha forte. O app troca isso por um
# cookie de sessão assinado (HttpOnly) — a senha não trafega de novo.
APP_PASSWORD=

# DEBUG=true expõe /docs e /api/debug/* (use só em desenvolvimento). Em produção: false.
DEBUG=false

# Origens permitidas para CORS. Vazio = apenas mesma origem (recomendado: frontend e
# API são servidos pela mesma origem via proxy). Liste origens separadas por vírgula só
# se realmente precisar de acesso cross-origin. Evite "*".
CORS_ORIGINS=

# Duração da sessão (horas). Padrão 720 (30 dias).
SESSION_TTL_HOURS=720

# --- Ghostfolio (somente leitura das suas posições) ---
# Endereço alcançável a partir do container do app. Recomendado: IP da LAN +
# porta publicada do Ghostfolio (o mesmo endereço que você já usa no navegador).
# Ex.: http://192.168.0.10:3333
# Alternativa (sem fixar IP): http://host.docker.internal:3333
GHOSTFOLIO_URL=http://host.docker.internal:3333

# "Security token" da sua conta Ghostfolio (Settings -> Security Token / "Sign in
# with Security Token"). O app troca isso por um JWT temporário automaticamente.
GHOSTFOLIO_ACCESS_TOKEN=

# --- brapi.dev (dados de mercado da B3, fallback de cotação) ---
# Crie um token grátis em https://brapi.dev/dashboard e cole aqui.
BRAPI_TOKEN=
# Plano da brapi: "free" (1 ticker/req) ou "pro" (multi-ticker). Padrão: free.
BRAPI_PLAN=free

# --- Persistência (SQLite, uso pessoal single-user) ---
# Caminho do banco de preferências/watchlist/histórico (relativo ao container do backend).
DB_PATH=data/pomar.db

# --- Cache ---
# Se vazio, o app usa cache em memória (ok para uso pessoal). Para usar o Redis
# do docker-compose, deixe como redis://redis:6379/0
REDIS_URL=redis://redis:6379/0
# Senha do Redis (recomendado em qualquer deploy). Deixe em branco só em dev local.
REDIS_PASSWORD=

# --- Servidor ---
# Porta web pública do frontend (a que você abre no navegador/celular)
WEB_PORT=3334
