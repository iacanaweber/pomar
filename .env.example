# ----------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha. O `.env` NÃO vai para o git.
# ----------------------------------------------------------------------------

# --- Ghostfolio (somente leitura das suas posições) ---
# Endereço alcançável a partir do container do app. Recomendado: IP da LAN +
# porta publicada do Ghostfolio (o mesmo endereço que você já usa no navegador).
# Ex.: http://192.168.0.10:3333
# Alternativa (sem fixar IP): http://host.docker.internal:3333
GHOSTFOLIO_URL=http://host.docker.internal:3333

# "Security token" da sua conta Ghostfolio (Settings -> Security Token / "Sign in
# with Security Token"). O app troca isso por um JWT temporário automaticamente.
GHOSTFOLIO_ACCESS_TOKEN=

# --- brapi.dev (dados de mercado da B3) ---
# Crie um token grátis em https://brapi.dev/dashboard e cole aqui.
BRAPI_TOKEN=

# --- Cache ---
# Se vazio, o app usa cache em memória (ok para uso pessoal). Para usar o Redis
# do docker-compose, deixe como redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# --- Servidor ---
# Origens permitidas para o frontend (CORS). Para acesso pelo celular na LAN,
# use "*" (uso pessoal em rede privada) ou liste os endereços.
CORS_ORIGINS=*

# Porta web pública do frontend (a que você abre no navegador/celular)
WEB_PORT=3334
